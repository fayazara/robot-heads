{
	"name": "robot-heads-site",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "pnpm --dir .. run build && tsc -b && vite build",
		"lint": "oxlint",
		"preview": "pnpm run build && vite preview",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"cuelume": "^0.2.4",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"robot-heads": "workspace:*"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.63.1",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@vitejs/plugin-react": "^6.1.1",
		"oxlint": "^1.81.0",
		"typescript": "~6.0.2",
		"vite": "^8.3.0",
		"wrangler": "^4.149.0"
	}
}
